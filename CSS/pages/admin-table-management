/* admin-table-management.css - Styles rieng cho trang admin-table-management */

.table-visual-card {
      background: var(--bg-card);
      border-radius: var(--radius-lg);
      border: 2px solid var(--border-color);
      padding: 18px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: var(--transition);
      position: relative;
    }
    .table-visual-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }
    .table-status-available { border-color: #10B981; }
    .table-status-occupied { border-color: #EF4444; }
    .table-status-reserved { border-color: #F59E0B; }
    .table-num-large {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--secondary);
    }
